# Copy to .env and fill in secrets. Never commit real secrets.
# Postgres (used by packages/db, apps/web, apps/game-server via DATABASE_URL)
DATABASE_URL=postgresql://pawnstorm:pawnstorm@localhost:5432/pawnstorm

# Redis (used by apps/game-server matchmaking + live games)
REDIS_URL=redis://localhost:6379

# NextAuth (apps/web)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Short-lived socket JWT, MUST be identical in web and game-server
GAME_SERVER_JWT_SECRET=change-me-to-another-long-random-string

# Where browsers reach the game server (Socket.IO + /health)
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000
# Game server port and allowed web origin (CORS)
GAME_SERVER_PORT=4000
WEB_ORIGIN=http://localhost:3000
