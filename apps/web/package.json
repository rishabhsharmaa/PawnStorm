{
  "name": "@pawnstorm/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "dotenv -e ../../.env -- next build",
    "start": "next start -p 3000",
    "dev": "dotenv -e ../../.env -- next dev -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@pawnstorm/db": "workspace:*",
    "@pawnstorm/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "chess.js": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.2.15",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-chessboard": "^4.0.0",
    "socket.io-client": "^4.7.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3"
