    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.0.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.0",
    "ioredis-mock": "^8.9.0",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3"
