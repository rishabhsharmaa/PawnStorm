{
  "name": "pawnstorm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "docker compose up -d && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "test": "turbo test",
    "e2e": "pnpm --filter @pawnstorm/web e2e",
    "loadtest": "pnpm --filter @pawnstorm/game-server loadtest",
    "db:generate": "pnpm --filter @pawnstorm/db prisma:generate",
    "db:migrate": "pnpm --filter @pawnstorm/db db:migrate",
    "db:seed": "pnpm --filter @pawnstorm/db db:seed",
    "setup": "docker compose up -d && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.8.0"
  }
}
